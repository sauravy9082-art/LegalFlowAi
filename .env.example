# Ollama Local AI Engine
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2:latest

# Database Connection (SQLite local, PostgreSQL supported)
DATABASE_URL=sqlite:///./storage/legalguard.db

# Vector Database (ChromaDB)
CHROMA_PATH=./chroma_db

# File Storage & Limits
MAX_UPLOAD_SIZE_MB=20
STORAGE_PATH=./storage

# Security JWT Secret
JWT_SECRET=legalguard-secret-key-super-secure-change-in-production-2026
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080
